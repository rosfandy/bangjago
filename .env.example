# Token bot Discord (dari https://discord.com/developers/applications)
DISCORD_TOKEN=

# Model AI ChatGPT (default: gpt-5.6-luna)
# OPENAI_MODEL=gpt-5.6-luna

# Refresh token OAuth utk deploy (login lokal dulu, ambil field "refresh"
# dari ~/.config/bangjago/openai-oauth.json). Kalau diset, bot skip login
# listener dan pakai token ini.
# OPENAI_REFRESH_TOKEN=

# Lokasi file token OAuth (default: ~/.config/bangjago/openai-oauth.json)
# OPENAI_OAUTH_PATH=

# OAuth callback — hanya utk login lokal (default: http://localhost:1455/auth/callback)
# OAUTH_PORT=1455
