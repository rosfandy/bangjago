# Token bot Discord (dari https://discord.com/developers/applications)
DISCORD_TOKEN=

# Model AI ChatGPT (default: gpt-5.6-luna)
# OPENAI_MODEL=gpt-5.6-luna

# Lokasi file token OAuth (default: ~/.config/bangjago/openai-oauth.json)
# OPENAI_OAUTH_PATH=

# OAuth callback (default: http://localhost:1455/auth/callback)
# OAUTH_PORT=1455
# OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
